{
  "name": "posewear",
  "private": true,
  "description": "衣姿 PoseWear：姿势、服装、人像参考图库与 AI 试穿工作台",
  "license": "MIT",
  "scripts": {
    "build": "python3 scripts/build-pages.py",
    "serve": "python3 -m http.server 8787 -d dist",
    "test": "node tests/run.mjs",
    "deploy": "wrangler pages deploy --branch main",
    "start": "node scripts/preview.mjs",
    "mcp": "node mcp/server.mjs",
    "test:offline": "node tests/run.mjs --offline",
    "build:full": "python3 scripts/build-pages.py --original",
    "build:full:pages": "python3 scripts/build-pages.py --original --media-origin https://posewear-iyoo-media.pages.dev",
    "dev:full": "wrangler pages dev dist-full --port 8789",
    "test:full": "node tests/full-catalog.js",
    "deploy:full-media": "cd dist-full-media && wrangler pages deploy . --project-name posewear-iyoo-media --branch main",
    "deploy:full-site": "wrangler pages deploy dist-full-site --project-name posewear-iyoo --branch main",
    "test:pages": "node tests/pages-regressions.js && node tests/v15-modules.js && node tests/v16-proxy.mjs && node tests/v18-quick.js",
    "build:upstream": "python3 build.py",
    "dev": "wrangler pages dev"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "playwright": "^1.48.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
